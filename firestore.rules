rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /tables/{tableId} {
      function attackRank(face) {
        return face == "💥" ? 4
          : face == "⚔" ? 3
          : face == "⚒" ? 2
          : face == "●" ? 1
          : face == "◐" ? 0 : -1;
      }

      function validBoardChoice(data) {
        return data.get("boardChoice", "") in ["verdant", "whispering", "blazing", "haven"]
          && data.get("boardOrientation", "") in ["landscape", "portrait"]
          && data.get("boardWinnerSide", "") in ["top", "bottom"]
          && attackRank(data.get("hostBoardRoll", "")) >= 0
          && attackRank(data.get("guestBoardRoll", "")) >= 0
          && attackRank(data.hostBoardRoll) != attackRank(data.guestBoardRoll);
      }

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.guestUid == null
        && request.resource.data.status == "waiting";

      allow update: if request.auth != null
        && (
          (
            resource.data.status == "waiting"
            && resource.data.guestUid == null
            && request.resource.data.hostUid == resource.data.hostUid
            && request.resource.data.guestUid == request.auth.uid
            && request.resource.data.status == "ready"
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["guestUid", "guestNick", "status", "updatedAt"])
          )
          ||
          (
            resource.data.hostUid == request.auth.uid
            && request.resource.data.hostUid == resource.data.hostUid
            && request.resource.data.guestUid == resource.data.guestUid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                "hostWarband",
                "hostDeckUrl",
                "hostRivalsDecks",
                "hostReady",
                "gameStarted",
                "status",
                "startedAt",
                "updatedAt"
              ])
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(["gameStarted", "status", "startedAt"])
              ||
              (
                request.resource.data.gameStarted == true
                && request.resource.data.status == "playing"
                && request.resource.data.hostReady == true
                && request.resource.data.guestReady == true
              )
            )
          )
          ||
          (
            resource.data.guestUid == request.auth.uid
            && request.resource.data.hostUid == resource.data.hostUid
            && request.resource.data.guestUid == resource.data.guestUid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                "guestWarband",
                "guestDeckUrl",
                "guestRivalsDecks",
                "guestReady",
                "gameStarted",
                "status",
                "startedAt",
                "updatedAt"
              ])
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(["gameStarted", "status", "startedAt"])
              ||
              (
                request.resource.data.gameStarted == true
                && request.resource.data.status == "playing"
                && request.resource.data.hostReady == true
                && request.resource.data.guestReady == true
              )
            )
          )
          ||
          (
            resource.data.gameStarted == true
            && resource.data.status == "playing"
            && (
              (resource.data.hostUid == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(["hostPhaseReady", "updatedAt"])
                && resource.data.get("hostPhaseReady", false) == false
                && request.resource.data.hostPhaseReady == true)
              ||
              (resource.data.guestUid == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(["guestPhaseReady", "updatedAt"])
                && resource.data.get("guestPhaseReady", false) == false
                && request.resource.data.guestPhaseReady == true)
            )
            && (
              (
                resource.data.get("gamePhase", "opening") != "opening"
                && (resource.data.gamePhase != "boards" || validBoardChoice(resource.data))
              )
              || (
                exists(/databases/$(database)/documents/tables/$(tableId)/private/$(request.auth.uid))
                && get(/databases/$(database)/documents/tables/$(tableId)/private/$(request.auth.uid)).data.get("openingConfirmed", false) == true
              )
            )
          )
          ||
          (
            // The second player confirms and advances the phase in a single update.
            resource.data.gameStarted == true
            && resource.data.status == "playing"
            && (
              (
                resource.data.hostUid == request.auth.uid
                && resource.data.get("hostPhaseReady", false) == false
                && resource.data.get("guestPhaseReady", false) == true
              )
              ||
              (
                resource.data.guestUid == request.auth.uid
                && resource.data.get("guestPhaseReady", false) == false
                && resource.data.get("hostPhaseReady", false) == true
              )
            )
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["gamePhase", "hostPhaseReady", "guestPhaseReady", "updatedAt"])
            && request.resource.data.gamePhase != resource.data.get("gamePhase", "opening")
            && request.resource.data.hostPhaseReady == false
            && request.resource.data.guestPhaseReady == false
            && (
              (
                resource.data.get("gamePhase", "opening") == "opening"
                && request.resource.data.gamePhase == "boards"
                && exists(/databases/$(database)/documents/tables/$(tableId)/private/$(request.auth.uid))
                && get(/databases/$(database)/documents/tables/$(tableId)/private/$(request.auth.uid)).data.get("openingConfirmed", false) == true
              )
              ||
              (resource.data.get("gamePhase", "opening") == "boards"
                && request.resource.data.gamePhase == "tokens"
                && validBoardChoice(resource.data))
              ||
              (resource.data.get("gamePhase", "opening") == "tokens"
                && request.resource.data.gamePhase == "deployment")
              ||
              (resource.data.get("gamePhase", "opening") == "deployment"
                && request.resource.data.gamePhase == "first-turn")
              ||
              (resource.data.get("gamePhase", "opening") == "first-turn"
                && request.resource.data.gamePhase == "round-one")
            )
          )
          ||
          (
            resource.data.gameStarted == true
            && resource.data.status == "playing"
            && (resource.data.hostUid == request.auth.uid || resource.data.guestUid == request.auth.uid)
            && resource.data.get("hostPhaseReady", false) == true
            && resource.data.get("guestPhaseReady", false) == true
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["gamePhase", "hostPhaseReady", "guestPhaseReady", "updatedAt"])
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasAll(["gamePhase", "hostPhaseReady", "guestPhaseReady"])
            && request.resource.data.hostPhaseReady == false
            && request.resource.data.guestPhaseReady == false
            && (
              (resource.data.get("gamePhase", "opening") == "opening" && request.resource.data.gamePhase == "boards")
              || (resource.data.gamePhase == "boards" && request.resource.data.gamePhase == "tokens"
                  && validBoardChoice(resource.data))
              || (resource.data.gamePhase == "tokens" && request.resource.data.gamePhase == "deployment")
              || (resource.data.gamePhase == "deployment" && request.resource.data.gamePhase == "first-turn")
              || (resource.data.gamePhase == "first-turn" && request.resource.data.gamePhase == "round-one")
            )
          )
          ||
          (
            resource.data.gameStarted == true
            && resource.data.status == "playing"
            && resource.data.get("gamePhase", "opening") == "boards"
            && resource.data.get("hostPhaseReady", false) == false
            && resource.data.get("guestPhaseReady", false) == false
            && (
              (
                resource.data.hostUid == request.auth.uid
                && resource.data.get("hostBoardRoll", "") == ""
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hostBoardRoll", "updatedAt"])
                && request.resource.data.hostBoardRoll in ["💥", "⚒", "⚔", "◐", "●"]
              )
              ||
              (
                resource.data.guestUid == request.auth.uid
                && resource.data.get("guestBoardRoll", "") == ""
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["guestBoardRoll", "updatedAt"])
                && request.resource.data.guestBoardRoll in ["💥", "⚒", "⚔", "◐", "●"]
              )
              ||
              (
                (resource.data.hostUid == request.auth.uid || resource.data.guestUid == request.auth.uid)
                && resource.data.get("hostBoardRoll", "") != ""
                && resource.data.get("guestBoardRoll", "") != ""
                && resource.data.hostBoardRoll == resource.data.guestBoardRoll
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hostBoardRoll", "guestBoardRoll", "updatedAt"])
                && request.resource.data.hostBoardRoll == ""
                && request.resource.data.guestBoardRoll == ""
              )
              ||
              (
                validBoardChoice(request.resource.data)
                && (
                  (
                    attackRank(resource.data.hostBoardRoll) > attackRank(resource.data.guestBoardRoll)
                    && resource.data.hostUid == request.auth.uid
                  )
                  ||
                  (
                    attackRank(resource.data.guestBoardRoll) > attackRank(resource.data.hostBoardRoll)
                    && resource.data.guestUid == request.auth.uid
                  )
                )
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(["boardChoice", "boardOrientation", "boardWinnerSide", "updatedAt"])
              )
            )
          )
        );

      allow delete: if request.auth != null
        && (
          resource.data.hostUid == request.auth.uid
          || resource.data.guestUid == request.auth.uid
        );

      match /private/{uid} {
        function tableData() {
          return get(/databases/$(database)/documents/tables/$(tableId)).data;
        }

        function isOwnPlayerDocument() {
          return request.auth != null
            && request.auth.uid == uid
            && (
              tableData().hostUid == request.auth.uid
              || tableData().guestUid == request.auth.uid
            );
        }

        allow read: if isOwnPlayerDocument();

        allow create: if isOwnPlayerDocument()
          && request.resource.data.keys().hasOnly([
            "objectiveHandIds",
            "objectiveDeckIds",
            "powerHandIds",
            "powerDeckIds",
            "objectiveMulliganUsed",
            "powerMulliganUsed",
            "openingConfirmed",
            "initializedAt",
            "updatedAt"
          ]);

        allow update: if isOwnPlayerDocument()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "objectiveHandIds",
            "objectiveDeckIds",
            "powerHandIds",
            "powerDeckIds",
            "objectiveMulliganUsed",
            "powerMulliganUsed",
            "openingConfirmed",
            "updatedAt"
          ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(["openingConfirmed"])
            || (
              resource.data.get("openingConfirmed", false) == false
              && request.resource.data.openingConfirmed == true
            )
          )
          && (
            resource.data.get("openingConfirmed", false) == false
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              "objectiveHandIds",
              "objectiveDeckIds",
              "powerHandIds",
              "powerDeckIds",
              "objectiveMulliganUsed",
              "powerMulliganUsed"
            ])
          );
      }
    }
  }
}
