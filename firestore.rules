rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /tables/{tableId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.guestUid == null
        && request.resource.data.status == "waiting";

      allow update: if request.auth != null
        && (
          // Druhý hráč může obsadit volné místo u čekajícího stolu.
          (
            resource.data.status == "waiting"
            && resource.data.guestUid == null
            && request.resource.data.hostUid == resource.data.hostUid
            && request.resource.data.guestUid == request.auth.uid
            && request.resource.data.status == "ready"
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["guestUid", "guestNick", "status", "updatedAt"])
          )
          ||
          // Hráč 1 smí měnit jen svůj veřejný setup a spustit hru.
          (
            resource.data.hostUid == request.auth.uid
            && request.resource.data.hostUid == resource.data.hostUid
            && request.resource.data.guestUid == resource.data.guestUid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                "hostWarband",
                "hostDeckUrl",
                "hostReady",
                "gameStarted",
                "status",
                "startedAt",
                "updatedAt"
              ])
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(["gameStarted", "status", "startedAt"])
              ||
              (
                request.resource.data.gameStarted == true
                && request.resource.data.status == "playing"
                && request.resource.data.hostReady == true
                && request.resource.data.guestReady == true
              )
            )
          )
          ||
          // Hráč 2 smí měnit jen svůj veřejný setup.
          (
            resource.data.guestUid == request.auth.uid
            && request.resource.data.hostUid == resource.data.hostUid
            && request.resource.data.guestUid == resource.data.guestUid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                "guestWarband",
                "guestDeckUrl",
                "guestReady",
                "updatedAt"
              ])
          )
        );

      allow delete: if request.auth != null
        && resource.data.hostUid == request.auth.uid;
    }
  }
}
